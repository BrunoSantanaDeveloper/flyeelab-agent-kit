# ===========================================
# Antigravity Kit - Git Ignore
# ===========================================
# NOTE: project/ folders are NOT ignored here
# They should be ignored in each PROJECT's .gitignore

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node (if scripts use it)
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
